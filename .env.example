# ==============================================================================
# UnifyHub Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env.local (frontend) or set these in Supabase Edge Functions.
# NEVER commit .env or .env.local into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite Client-Safe Variables)
# Accessible in browser code via import.meta.env
# ------------------------------------------------------------------------------

# Supabase Project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Base URL where UnifyHub is hosted (e.g., http://localhost:5173 in local dev)
VITE_APP_URL=http://localhost:5173

# Fallback to realistic demo mode if keys are not configured or Supabase is offline (true/false)
VITE_ENABLE_DEMO_FALLBACK=true


# ------------------------------------------------------------------------------
# BACKEND & SUPABASE EDGE FUNCTIONS SECRETS
# Set using: supabase secrets set KEY=VALUE
# NEVER prefix with VITE_ and NEVER expose to the browser!
# ------------------------------------------------------------------------------

# Supabase Service Role Secret Key (Required for edge sync operations bypassing RLS)
# Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 32-byte secret used for AES-GCM encryption of stored OAuth refresh tokens in DB
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google Gemini API Key for daily briefings and smart task parsing from emails
# Source: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# --- Provider OAuth: Google ---
# Source: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=google
#
# REQUIRED: enable these APIs in the SAME Google Cloud project as the OAuth client,
# or every sync returns HTTP 403 accessNotConfigured:
#   Calendar API  https://console.developers.google.com/apis/api/calendar-json.googleapis.com
#   Gmail API     https://console.developers.google.com/apis/api/gmail.googleapis.com
#   Drive API     https://console.developers.google.com/apis/api/drive.googleapis.com
#   Tasks API     https://console.developers.google.com/apis/api/tasks.googleapis.com
#   Classroom API https://console.developers.google.com/apis/api/classroom.googleapis.com
# After enabling an API, wait ~1 minute for propagation, then press Sync Now.

# --- Provider OAuth: Microsoft (Outlook, Calendars, OneDrive, Teams) ---
# Source: Azure Portal -> Entra ID -> App registrations
MICROSOFT_CLIENT_ID=your-microsoft-app-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=microsoft

# --- Provider OAuth: GitHub ---
# Source: GitHub Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# --- Provider OAuth: Notion ---
# Source: Notion Developers -> My Integrations
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret

# --- Provider OAuth: Todoist ---
# Source: Todoist App Management Console
TODOIST_CLIENT_ID=your-todoist-client-id
TODOIST_CLIENT_SECRET=your-todoist-client-secret

# --- Provider OAuth: Slack ---
# Source: Slack API -> Your Apps -> Basic Information
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# --- Provider OAuth: Linear ---
# Source: Linear Settings -> API -> Applications
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret

# --- Notification Providers ---
# Resend (Email Notifications): https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# Telegram Bot (Daily reminders): Create via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# Web Push VAPID Keys: Generate via npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Twilio (SMS Notifications - optional): https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Cloud API (Optional): Meta for Developers
WHATSAPP_API_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-id
