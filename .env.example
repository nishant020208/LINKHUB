# ==============================================================================
# UnifyHub Environment Configuration Template (.env.example)
# ==============================================================================
# Copy the FRONTEND section into .env.local for local dev. Everything in the
# SERVER-ONLY section is set on Supabase, never in .env.local:
#
#     supabase secrets set KEY=value KEY2=value2
#
# (or Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets)
#
# Never put a real secret in this file, and never commit .env / .env.local.
# ==============================================================================


# ==============================================================================
# FRONTEND (Vite client-safe) — place these in .env.local
# ==============================================================================

# Supabase Project URL. Where: Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon / public key (safe in the browser).
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL the app is served from (local: http://localhost:5173).
VITE_APP_URL=http://localhost:5173

# Show realistic demo data for providers not yet connected (true/false).
VITE_ENABLE_DEMO_FALLBACK=true


# ==============================================================================
# SERVER-ONLY SECRETS (Supabase Edge Function secrets — NEVER in .env.local)
# ==============================================================================

# --- Core ---

# Service role key; lets Edge sync functions bypass RLS.
# Where: Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32-byte hex key (AES-256-GCM) used to encrypt stored provider tokens.
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# Public app URL used to send the browser back after OAuth completes.
APP_URL=https://your-app-url

# Optional dedicated HMAC key for OAuth state; falls back to TOKEN_ENCRYPTION_KEY.
STATE_SIGNING_KEY=optional-state-signing-key


# --- Provider OAuth credentials ---
# Every provider registers the SAME redirect URI (no query string):
#   https://<your-project-id>.supabase.co/functions/v1/oauth-callback

# Google — https://console.cloud.google.com/apis/credentials
# Then enable Calendar, Gmail, Drive, Tasks and Classroom APIs in the same project.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub — https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Notion — https://www.notion.so/my-integrations (use secret + client id)
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret

# Todoist — https://developer.todoist.com/appconsole.html
TODOIST_CLIENT_ID=your-todoist-client-id
TODOIST_CLIENT_SECRET=your-todoist-client-secret

# Slack — https://api.slack.com/apps -> OAuth & Permissions
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# Linear — https://linear.app/settings/api/applications
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret

# Jira (Atlassian 3LO) — https://developer.atlassian.com/console/myapps/
# Requested audience is api.atlassian.com; cloudId is resolved at connect time.
JIRA_CLIENT_ID=your-jira-client-id
JIRA_CLIENT_SECRET=your-jira-client-secret

# Trello — https://trello.com/power-ups/admin (API key only; token flow)
TRELLO_API_KEY=your-trello-api-key

# Asana — https://app.asana.com/0/developer-console
ASANA_CLIENT_ID=your-asana-client-id
ASANA_CLIENT_SECRET=your-asana-client-secret

# ClickUp — https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=your-clickup-client-id
CLICKUP_CLIENT_SECRET=your-clickup-client-secret

# Dropbox — https://www.dropbox.com/developers/apps (App key + secret)
# Authorize adds token_access_type=offline to receive a refresh token.
DROPBOX_CLIENT_ID=your-dropbox-app-key
DROPBOX_CLIENT_SECRET=your-dropbox-app-secret

# Box — https://app.box.com/developers/console (Client ID + secret)
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret

# Zoom — https://marketplace.zoom.us/develop/create
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# GitLab — https://gitlab.com/-/profile/applications
GITLAB_CLIENT_ID=your-gitlab-application-id
GITLAB_CLIENT_SECRET=your-gitlab-secret

# Bitbucket — https://bitbucket.org/account/settings/api/
BITBUCKET_CLIENT_ID=your-bitbucket-key
BITBUCKET_CLIENT_SECRET=your-bitbucket-secret

# Note: Moodle LMS and Custom IMAP are NOT OAuth. Users supply their own portal
# URL / web-service token and IMAP host / username / app password in the app;
# no server secrets are required for them.


# --- AI / notifications ---

# Google Gemini (AI briefing + action extraction) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Resend (email notifications) — https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Telegram bot (daily reminders) — create via @BotFather
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# Web push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Optional SMS / WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
