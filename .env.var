# ==============================================================================
# UnifyHub — Complete Environment Variable Specification (.env.var)
# ==============================================================================
# Canonical template for every variable UnifyHub reads. Copy the FRONTEND
# values into .env.local; set the SERVER-ONLY values with:
#     supabase secrets set KEY=value
# Never commit real credentials or .env.local.
# ==============================================================================


# ==============================================================================
# 1. FRONTEND CLIENT CONFIGURATION (Vite — safe for the browser)
# ==============================================================================

# Supabase Project URL — Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon / public key
VITE_SUPABASE_ANON_KEY=your-anon-key

# App base URL (local: http://localhost:5173)
VITE_APP_URL=http://localhost:5173

# Demo fallback for unconnected providers (true/false)
VITE_ENABLE_DEMO_FALLBACK=true


# ==============================================================================
# 2. SUPABASE EDGE FUNCTIONS & BACKEND CORE SECRETS
# ==============================================================================

# Service role key (bypasses RLS for Edge sync workers)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 32-byte hex key (AES-256-GCM) for encrypting stored provider tokens
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_character_hex_string

# Public app URL used to redirect the browser back after OAuth
APP_URL=http://localhost:5173

# Optional dedicated OAuth state-signing key (falls back to TOKEN_ENCRYPTION_KEY)
STATE_SIGNING_KEY=optional-state-signing-key

# Google Gemini (AI briefing + action extraction)
GEMINI_API_KEY=your-gemini-api-key


# ==============================================================================
# 3. PROVIDER OAUTH CREDENTIALS
# ==============================================================================
# Shared redirect URI for every OAuth provider (no query string):
#   https://your-project-id.supabase.co/functions/v1/oauth-callback

# --- Google (Gmail, Calendar, Classroom, Drive, Tasks) ---
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- GitHub (Issues, Pull Requests, Notifications) ---
# https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- Notion (Databases, Tasks, Workspace Documents) ---
# https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret

# --- Todoist (Tasks, Projects, Deadlines) ---
# https://developer.todoist.com/appconsole.html
TODOIST_CLIENT_ID=your-todoist-client-id
TODOIST_CLIENT_SECRET=your-todoist-client-secret

# --- Slack (Mentions, Reminders, Saved messages) ---
# https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret

# --- Linear (Cycles, Issues, Project Milestones) ---
# https://linear.app/settings/api/applications
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret

# --- Jira / Atlassian 3LO (Sprints, Tickets, Assigned Tasks) ---
# https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your-atlassian-client-id
JIRA_CLIENT_SECRET=your-atlassian-client-secret

# --- Trello (Boards, Lists, Cards) — API key only (fragment token flow) ---
# https://trello.com/power-ups/admin
TRELLO_API_KEY=your-trello-api-key

# --- Asana (Projects, Tasks, Milestones) ---
# https://app.asana.com/0/developer-console
ASANA_CLIENT_ID=your-asana-client-id
ASANA_CLIENT_SECRET=your-asana-client-secret

# --- ClickUp (Spaces, Folders, Tasks) ---
# https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=your-clickup-client-id
CLICKUP_CLIENT_SECRET=your-clickup-client-secret

# --- Dropbox (Recent & Starred Cloud Files) ---
# https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=your-dropbox-app-key
DROPBOX_CLIENT_SECRET=your-dropbox-app-secret

# --- Box (Enterprise Content & Storage) ---
# https://app.box.com/developers/console
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret

# --- Zoom (Upcoming Video Conferences & Links) ---
# https://marketplace.zoom.us/develop/create
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# --- GitLab (Merge Requests, Issues, Pipelines) ---
# https://gitlab.com/-/profile/applications
GITLAB_CLIENT_ID=your-gitlab-application-id
GITLAB_CLIENT_SECRET=your-gitlab-secret

# --- Bitbucket (Pull Requests & Repositories) ---
# https://bitbucket.org/account/settings/api/
BITBUCKET_CLIENT_ID=your-bitbucket-key
BITBUCKET_CLIENT_SECRET=your-bitbucket-secret

# Note: Moodle LMS and Custom IMAP are NOT OAuth — users supply their own
# portal URL / web-service token and IMAP host / username / app password in the
# app. No server secrets are required for them.


# ==============================================================================
# 4. MULTI-CHANNEL NOTIFICATION DISPATCHERS
# ==============================================================================

# --- Resend (transactional email alerts) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key

# --- Telegram bot (urgent notifications) ---
# Create via @BotFather
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token

# --- Web push VAPID keys ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# --- Twilio (SMS + optional WhatsApp) ---
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
