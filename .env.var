# ==============================================================================
# UnifyHub — Complete Environment Variables Specification (.env.var)
# ==============================================================================
# This file lists every environment variable and secret placeholder required
# to make UnifyHub fully operational across the frontend, Supabase Edge Functions,
# OAuth providers, and notification channels.
#
# HOW TO USE:
# 1. FRONTEND: Copy the 4 "VITE_" variables below into your local `.env.local`
#    (or configure them in your Vercel Project Settings -> Environment Variables).
# 2. BACKEND: For Supabase Edge Functions, set server secrets via the Supabase CLI:
#       supabase secrets set KEY_NAME=value
#    or configure them in Supabase Dashboard -> Project Settings -> Edge Functions.
# 3. NEVER commit real credentials or .env.local to version control.
# ==============================================================================


# ==============================================================================
# 1. FRONTEND CLIENT CONFIGURATION (Vite — Safe for Browser)
# ==============================================================================
# These 4 variables are ALL you need in .env.local to get the full UI and database running.

# [REQUIRED] Supabase Project API URL
# Where to find: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# [REQUIRED] Supabase Anon / Public Key (Safe for browser client JWT)
# Where to find: Supabase Dashboard -> Project Settings -> API -> anon / public key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# [REQUIRED] Application Base URL (Used for OAuth redirects and CORS)
# For local dev: http://localhost:5173
# For production: https://your-unifyhub-domain.vercel.app
VITE_APP_URL=http://localhost:5173

# [RECOMMENDED] Enable Demo Fallback Mode (true / false)
# When true, unconfigured providers gracefully display realistic mock data
# rather than empty cards or errors. Set to true for development.
VITE_ENABLE_DEMO_FALLBACK=true


# ==============================================================================
# 2. SUPABASE EDGE FUNCTIONS & BACKEND CORE SECRETS
# ==============================================================================
# Set these using: supabase secrets set KEY=VALUE

# [REQUIRED FOR SYNC] Supabase Service Role Secret Key
# Bypasses RLS to allow Edge sync workers to write provider items to Postgres.
# Where to find: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# [REQUIRED FOR SYNC] 32-Byte Hex Token Encryption Key (AES-256-GCM)
# Encrypts user OAuth refresh tokens before storing in database.
# How to generate: Run in your terminal: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=replace_with_64_character_hex_string_from_openssl_rand_hex_32

# [REQUIRED FOR AI] Google Gemini API Key
# Powers the AI Executive Daily Briefing and Action Item Extraction.
# Where to get: Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key


# ==============================================================================
# 3. TIER 1 CORE PROVIDERS (OAuth 2.0 & APIs)
# ==============================================================================

# --- Google (Calendar, Gmail, Drive, Tasks, Classroom) ---
# Console: https://console.cloud.google.com/apis/credentials
# Note: Enable Google Calendar API, Gmail API, Drive API, Tasks API, Classroom API
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=google

# --- Microsoft (Outlook Mail, Outlook Calendar, OneDrive, Teams) ---
# Console: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
# Note: Register Single/Multi-tenant App, add Redirect URI (Web) to Supabase callback
MICROSOFT_CLIENT_ID=your-azure-application-client-id
MICROSOFT_CLIENT_SECRET=your-azure-client-secret-value
MICROSOFT_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=microsoft

# --- GitHub (Issues, Pull Requests, Notifications) ---
# Console: https://github.com/settings/developers -> OAuth Apps
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=github

# --- Canvas LMS (Courses, Assignments, Announcements) ---
# Console: Canvas LMS -> Account -> Settings -> Approved Integrations / Developer Keys
CANVAS_BASE_URL=https://canvas.instructure.com
CANVAS_API_TOKEN=your-canvas-user-access-token
CANVAS_CLIENT_ID=your-canvas-developer-key-id
CANVAS_CLIENT_SECRET=your-canvas-developer-key-secret


# ==============================================================================
# 4. TIER 2 & TIER 3 PRODUCTIVITY & DEVELOPER PROVIDERS
# ==============================================================================

# --- Notion (Databases, Tasks, Workspace Documents) ---
# Console: https://www.notion.so/my-integrations
NOTION_CLIENT_ID=your-notion-oauth-client-id
NOTION_CLIENT_SECRET=your-notion-oauth-client-secret
NOTION_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=notion

# --- Todoist (Tasks, Projects, Deadlines) ---
# Console: https://developer.todoist.com/appconsole.html
TODOIST_CLIENT_ID=your-todoist-client-id
TODOIST_CLIENT_SECRET=your-todoist-client-secret
TODOIST_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=todoist

# --- Slack (Mentions, Reminders, Direct Messages) ---
# Console: https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=slack

# --- Linear (Cycles, Issues, Project Milestones) ---
# Console: https://linear.app/settings/api/applications/new
LINEAR_CLIENT_ID=your-linear-client-id
LINEAR_CLIENT_SECRET=your-linear-client-secret
LINEAR_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=linear

# --- Jira / Atlassian (Sprints, Tickets, Assigned Tasks) ---
# Console: https://developer.atlassian.com/console/myapps/
JIRA_CLIENT_ID=your-atlassian-client-id
JIRA_CLIENT_SECRET=your-atlassian-client-secret
JIRA_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=jira

# --- Asana (Projects, Tasks, Milestones) ---
# Console: https://app.asana.com/0/developer-console
ASANA_CLIENT_ID=your-asana-client-id
ASANA_CLIENT_SECRET=your-asana-client-secret
ASANA_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=asana

# --- Trello (Boards, Lists, Cards) ---
# Console: https://trello.com/power-ups/admin
TRELLO_API_KEY=your-trello-api-key
TRELLO_API_SECRET=your-trello-api-secret

# --- ClickUp (Spaces, Folders, Tasks) ---
# Console: https://app.clickup.com/settings/apps
CLICKUP_CLIENT_ID=your-clickup-client-id
CLICKUP_CLIENT_SECRET=your-clickup-client-secret
CLICKUP_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=clickup

# --- Zoom (Upcoming Video Conferences & Links) ---
# Console: https://marketplace.zoom.us/develop/create
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=zoom

# --- Dropbox (Recent & Starred Cloud Files) ---
# Console: https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=your-dropbox-app-key
DROPBOX_CLIENT_SECRET=your-dropbox-app-secret
DROPBOX_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=dropbox

# --- Box (Enterprise Content & Storage) ---
# Console: https://app.box.com/developers/console
BOX_CLIENT_ID=your-box-client-id
BOX_CLIENT_SECRET=your-box-client-secret
BOX_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=box

# --- GitLab (Merge Requests, Issues, Pipelines) ---
# Console: https://gitlab.com/-/profile/applications
GITLAB_CLIENT_ID=your-gitlab-application-id
GITLAB_CLIENT_SECRET=your-gitlab-secret
GITLAB_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=gitlab

# --- Bitbucket (Pull Requests & Repositories) ---
# Console: https://bitbucket.org/account/settings/api/
BITBUCKET_CLIENT_ID=your-bitbucket-key
BITBUCKET_CLIENT_SECRET=your-bitbucket-secret
BITBUCKET_REDIRECT_URI=https://your-project-id.supabase.co/functions/v1/oauth-callback?provider=bitbucket

# --- Moodle (University Course Events & Deadlines) ---
# Settings: Moodle Admin -> Plugins -> Web Services -> External Services
MOODLE_BASE_URL=https://moodle.your-university.edu
MOODLE_API_TOKEN=your-moodle-web-service-token

# --- IMAP / Generic Email (TLS Email Sync) ---
# Used for custom academic / corporate email inboxes
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=your-email@example.com
IMAP_PASSWORD=your-imap-app-password


# ==============================================================================
# 5. MULTI-CHANNEL NOTIFICATION DISPATCHERS
# ==============================================================================

# --- Resend (Transactional Email Alerts) ---
# Console: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=alerts@your-verified-domain.com

# --- Telegram Bot (Direct Urgent Notifications) ---
# Create via @BotFather on Telegram (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
TELEGRAM_DEFAULT_CHAT_ID=your-telegram-chat-id

# --- Web Push (Browser Desktop & Mobile Push Notifications) ---
# Generate keys via terminal: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@unifyhub.app

# --- Twilio (SMS Urgent Deadlines - Optional) ---
# Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# --- WhatsApp Cloud API (Optional) ---
# Console: Meta for Developers -> WhatsApp Business Platform
WHATSAPP_API_TOKEN=your-meta-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
